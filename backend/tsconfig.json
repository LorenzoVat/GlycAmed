{
  "compilerOptions": {
    "target": "es2020",                
    "module": "commonjs",              
    "esModuleInterop": true,           
    "forceConsistentCasingInFileNames": true, 
    "skipLibCheck": true,              

    "strict": true,                    
    "noImplicitAny": true,             
    "strictNullChecks": true,          

    "rootDir": "./src",                
    "outDir": "./dist",                

    "sourceMap": true                  
  },
  "include": [
    "src/**/*"                         
  ],
  "exclude": [
    "node_modules"                     
  ]
}