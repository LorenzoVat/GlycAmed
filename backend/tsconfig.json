{
  "compilerOptions": {
    "target": "es2020",                
    "module": "commonjs",              
    "esModuleInterop": true,           
    "forceConsistentCasingInFileNames": true, 
    "skipLibCheck": true,              

    "strict": true,                    
    "noImplicitAny": true,             
    "strictNullChecks": true,          

    "rootDir": "./src",                
    "outDir": "./dist",                

    "sourceMap": true,
    
    "baseUrl": "./src",
    "paths": {
      "@models/*": ["models/*"],
      "@controllers/*": ["controllers/*"],
      "@services/*": ["services/*"],
      "@routes/*": ["routes/*"],
      "@middlewares/*": ["middlewares/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"],
      "@validation/*": ["validation/*"]
    }
  },
  "include": [
    "src/**/*"                         
  ],
  "exclude": [
    "node_modules"                     
  ]
}